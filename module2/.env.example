# Sentinel core settings
ORS_API_KEY=your_ors_api_key_here
BACKEND_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
INCIDENT_ROUTE_RADIUS_METERS=500
CRITICAL_SAFETY_THRESHOLD=60
MIN_SAFETY_IMPROVEMENT=15
MAX_EXTRA_TRAVEL_MINUTES=10
DEMO_MODE=true
POLLING_INTERVAL_SECONDS=15
TEMPORAL_DECAY_MINUTES=60
SIM_SPEED=2

# Optional xAI safety-assistant provider
GROK_API_KEY=your_grok_api_key_here

# SMTP / email settings for SOS guardian alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Optional aliases accepted by the backend too
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=your-email@gmail.com
  